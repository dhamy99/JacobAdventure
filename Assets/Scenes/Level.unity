      propertyPath: questAfter.Array.data[0]
      value: Thank you for the dog thing.
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questAfter.Array.data[1]
      value: 'I''ll make sure to get it chained so it doesn''t happen again. '
