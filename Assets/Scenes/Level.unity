    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questAfter.Array.data[0]
      value: Thank you. My kid doesn't stop talking about you helping her.
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questOther.Array.data[0]
      value: You are working hard, aren't you?
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[0]
      value: 'Hey, Jacob. I''ve heard about you. I have a request. '
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[1]
      value: It's about my daughter. With all that blue stuff and the monsters...
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[2]
      value: I'm worried about her. Could you go find her?
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[3]
      value: She said she was going to befriend the flames or something like that...
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[4]
      value: 'Please, go get her. '
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questStartedPhrases.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questNotStartedPhrases.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questStartedPhrases.Array.data[0]
      value: Have you seen my daughter?
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questNotStartedPhrases.Array.data[0]
      value: ... This girl...
      objectReference: {fileID: 0}
