    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questOther.Array.data[0]
      value: '... Come find me later. '
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[0]
      value: Hey. Jacob, aren't you? I can give you some money if you do something
        for me.
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[1]
      value: I'm looking for my dog. Can you look for it?
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
      propertyPath: questPhrases.Array.data[2]
      value: I don't have tome to go wandering around.
      objectReference: {fileID: 0}
    - target: {fileID: 7345000517831762059, guid: c46e3f5c9e577f04cae27756d4b3b88e, type: 3}
